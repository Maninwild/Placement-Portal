PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=placement_app
DB_PASSWORD=replace_with_your_database_password
DB_NAME=placement_portal

# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=8h

# Leave blank when the frontend is served by this Express application.
CORS_ORIGIN=

# Used only by `npm run seed`.
SEED_TEACHER_NAME=Placement Coordinator
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=replace_with_a_strong_teacher_password
